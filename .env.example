# Supabase Config
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Gemini AI API Config (Get a key from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key

# App-level encryption key for sensitive content
APP_ENCRYPTION_KEY=your_long_random_encryption_key

# Spotify OAuth Config (Optional - Phase 2)
# Register an app on developer.spotify.com and configure callback redirect URI:
# e.g., http://localhost:3000/api/auth/spotify/callback
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/spotify/callback

# GIPHY API Config (server-side only; proxy through /api/giphy/*)
GIPHY_API_KEY=your_giphy_api_key
